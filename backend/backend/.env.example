# Copy this file to ".env" and fill in your own values. NEVER commit ".env".

# MongoDB Atlas connection string (Atlas -> Connect -> Drivers -> Python)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=spectrace

# Comma-separated list of frontend origins allowed by CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Upload limits
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=50

# "mock" = placeholder adapter (clearly labelled, NOT real analysis)
# "real" = import the SpecTrace AI Engine (ai_engine.backend_adapter)
ANALYSIS_ENGINE=mock
ANALYSIS_ENGINE_MODULE=ai_engine.backend_adapter

# Gemini API settings (only needed when ANALYSIS_ENGINE=real)
# Leave GEMINI_API_KEY blank or unset to run in static_fallback mode without Gemini.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_TIMEOUT_SECONDS=30
